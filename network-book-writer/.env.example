# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Drive (OAuth2 또는 Service Account)
GOOGLE_CREDENTIALS_PATH=config/credentials.json
GOOGLE_TOKEN_PATH=config/token.json
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# 로드맵 파일 ID (구글드라이브 내 목차/로드맵 문서 ID)
ROADMAP_FILE_ID=your-roadmap-file-id

# 알림 설정 (Pushover)
PUSHOVER_USER_KEY=your-user-key
PUSHOVER_API_TOKEN=your-api-token

# 동시 처리 설정
MAX_CONCURRENT_CHAPTERS=5

# AI 모델 설정
CLAUDE_MODEL=claude-opus-4-20250918

# 웹 검색 설정 (Anthropic 웹 검색 또는 외부 API)
SEARCH_API_KEY=your-search-api-key
